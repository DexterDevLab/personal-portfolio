---
import Base from "@/layouts/Base.astro";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { site } from "@/data/site";
---

<Base title={`Page not found — ${site.name}`} description="This page doesn't exist." noindex bare>
  <div class="flex min-h-svh flex-col items-center justify-center gap-4 px-5 text-center sm:px-6">
    <Eyebrow>404</Eyebrow>
    <h1 class="text-3xl font-semibold">This page doesn't exist.</h1>
    <p class="max-w-md text-muted">The link may be old or mistyped — but the work is still here.</p>
    <Button href="/" class="mt-2">Back home</Button>
  </div>
</Base>
