---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import JsonLd from "@/components/JsonLd.astro";
import Lab from "@/components/lab/Lab.astro";
import Trunk from "@/components/decor/Trunk.astro";
import Hero from "@/components/sections/Hero.astro";
import Featured from "@/components/sections/Featured.astro";
import Work from "@/components/sections/Work.astro";
import Services from "@/components/sections/Services.astro";
import Process from "@/components/sections/Process.astro";
import About from "@/components/sections/About.astro";
import Contact from "@/components/sections/Contact.astro";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const featured = work.find((entry) => entry.data.featured);
if (!featured) throw new Error("Mark exactly one entry in src/content/work as `featured: true`.");
const clientWork = work.filter((entry) => !entry.data.featured);
---

<Base lab>
  <Fragment slot="head">
    <JsonLd projects={work} />
  </Fragment>

  <!-- Hero: the interactive room on WebGL devices (3D lab on), a static hero otherwise -->
  <Lab featured={featured} projects={clientWork} />
  <div data-page-only>
    <Hero featured={featured} />
  </div>

  <!-- The portfolio, with the signal cable running down the left margin -->
  <div class="relative" data-page-body>
    <Trunk />
    <Featured project={featured} />
    <Work projects={clientWork} />
    <Services />
    <Process />
    <About />
    <Contact />
  </div>
</Base>

<script>
  import { initChoreography } from "@/scroll/choreography";
  initChoreography();
</script>
