---
import { getCollection } from "astro:content";
import { PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/client";
import Base from "@/layouts/Base.astro";
import JsonLd from "@/components/JsonLd.astro";
import Lab from "@/components/lab/Lab.astro";
import Hero from "@/components/sections/Hero.astro";
import Featured from "@/components/sections/Featured.astro";
import Work from "@/components/sections/Work.astro";
import Services from "@/components/sections/Services.astro";
import Process from "@/components/sections/Process.astro";
import About from "@/components/sections/About.astro";
import Contact from "@/components/sections/Contact.astro";
import PageRobot from "@/components/decor/PageRobot.astro";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const featured = work.find((entry) => entry.data.featured);
if (!featured) throw new Error("Mark exactly one entry in src/content/work as `featured: true`.");
const clientWork = work.filter((entry) => !entry.data.featured);
---

<Base lab>
  <Fragment slot="head">
    <JsonLd projects={work} />
    {
      PUBLIC_TURNSTILE_SITE_KEY && (
        <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
      )
    }
  </Fragment>

  <!-- Hero: the interactive room on WebGL devices (3D lab on), a static hero otherwise -->
  <Lab featured={featured} projects={clientWork} />
  <div data-page-only>
    <Hero featured={featured} />
  </div>

  <!-- The portfolio: one station per section, each with its own short scene -->
  <div class="relative" data-page-body>
    <Featured project={featured} />
    <Work projects={clientWork} />
    <Services />
    <Process />
    <About />
    <Contact />
  </div>
  <!-- The assistant, walking down the margin beside the page (wide screens, motion allowed) -->
  <PageRobot />
</Base>

<script>
  import { initChoreography } from "@/scroll/choreography";
  initChoreography();
</script>
