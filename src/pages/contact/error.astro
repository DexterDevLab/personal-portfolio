---
import Base from "@/layouts/Base.astro";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { messageForCode } from "@/lib/contact";
import { site } from "@/data/site";

// Rendered on demand so the ?code= query can pick the right message
// for visitors submitting the form without JavaScript.
export const prerender = false;

const message = messageForCode(Astro.url.searchParams.get("code"));
---

<Base title={`Message not sent — ${site.name}`} description="Your message could not be sent." noindex>
  <div class="mx-auto flex min-h-[70vh] max-w-xl flex-col items-start justify-center gap-4 px-5 py-32 sm:px-6">
    <Eyebrow>Message not sent</Eyebrow>
    <h1 class="text-3xl font-semibold">{message}</h1>
    <p class="text-muted">You can go back and try again, or email me directly at <a href={`mailto:${site.email}`} class="text-accent underline-offset-4 hover:underline">{site.email}</a>.</p>
    <Button href="/#contact" class="mt-2">Back to the form</Button>
  </div>
</Base>
