---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { ArrowLeft, ArrowRight, ArrowUpRight } from "@lucide/astro";
import Base from "@/layouts/Base.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Screenshot from "@/components/ui/Screenshot.astro";
import Tag from "@/components/ui/Tag.astro";
import { site } from "@/data/site";

export async function getStaticPaths() {
  const entries = await getCollection("work", (entry) => entry.data.caseStudy);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const liveHost = data.liveUrl ? new URL(data.liveUrl).host : undefined;
---

<Base title={`${data.title} — case study | ${site.name}`} description={data.summary}>
  <article>
    <div class="border-b-2 border-border-strong bg-background-deep grid-floor">
      <Container class="pt-28 pb-10 lg:pt-36">
        <a href="/#work" class="btn btn-ghost btn-sm -ml-3">
          <ArrowLeft class="size-4" aria-hidden="true" />
          All work
        </a>
        <div class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:items-end">
          <div>
            <Eyebrow class="mb-3" tone="orange">Case study · main control system</Eyebrow>
            <h1 class="text-4xl font-bold leading-[1.05] sm:text-5xl">{data.title}</h1>
            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{data.summary}</p>
          </div>
          <dl class="outlined-sm grid grid-cols-2 gap-x-6 gap-y-4 rounded-card bg-surface p-5 text-sm lg:grid-cols-1">
            <div>
              <dt class="label-mono text-muted">Status</dt>
              <dd class="mt-1 flex items-center gap-2"><span class="led bg-teal" aria-hidden="true"></span>{data.statusLabel ?? data.status}</dd>
            </div>
            <div>
              <dt class="label-mono text-muted">My role</dt>
              <dd class="mt-1">{data.role}</dd>
            </div>
            <div class="col-span-2 lg:col-span-1">
              <dt class="label-mono text-muted">Stack</dt>
              <dd class="mt-2 flex flex-wrap gap-2">{data.stack.map((tag) => <Tag>{tag}</Tag>)}</dd>
            </div>
          </dl>
        </div>
      </Container>
    </div>

    <Container class="-mt-6 lg:-mt-8">
      <Screenshot label={liveHost} tag="Overview screen">
        <Image
          src={data.screenshot}
          alt={data.screenshotAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1160px) calc(100vw - 2.5rem), 1120px"
          priority
          class="w-full"
        />
      </Screenshot>
      {
        data.liveUrl && (
          <p class="mt-3 text-sm text-muted">
            Overview screen of the production app.{" "}
            <a href={data.liveUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-medium text-accent underline-offset-4 hover:underline">
              {liveHost}
              <ArrowUpRight class="size-3.5" aria-hidden="true" />
            </a>{" "}
            (login required).
          </p>
        )
      }
    </Container>

    <Container class="py-14 md:py-20">
      <div class="outlined paper rounded-card px-6 py-8 sm:px-10 sm:py-10">
        <div class="prose">
          <Content />
        </div>
      </div>
    </Container>

    <Container class="pb-20">
      <div class="outlined rounded-card bg-surface p-6 sm:p-8">
        <Eyebrow class="mb-3">Communication station</Eyebrow>
        <h2 class="text-2xl font-bold">Need something built, fixed, or maintained?</h2>
        <p class="mt-2 max-w-2xl text-muted">
          Whether it's an internal tool like this one, a WordPress site, or a problem nobody else wants to debug,
          tell me what you're dealing with.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href="/#contact">
            Discuss your project
            <ArrowRight class="size-4" aria-hidden="true" />
          </Button>
          <Button href="/#work" variant="secondary">See more work</Button>
        </div>
      </div>
    </Container>
  </article>
</Base>
