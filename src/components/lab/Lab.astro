---
import { Image, getImage } from "astro:assets";
import { ArrowRight, ArrowUpRight, Download, Mail } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import Button from "@/components/ui/Button.astro";
import Tag from "@/components/ui/Tag.astro";
import GithubIcon from "@/components/ui/GithubIcon.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ContactForm from "@/components/ContactForm.astro";
import StationList from "./StationList.astro";
import StationPanel from "./StationPanel.astro";
import ModeSwitch from "./ModeSwitch.astro";
import portrait from "@/assets/portrait.jpg";
import { site } from "@/data/site";
import { services, engagementLine } from "@/data/services";
import { processSteps } from "@/data/process";
import { aboutParagraphs, contactHelp, intro, stack, troubleshootingSteps } from "@/data/about";

/**
 * The interactive laboratory: a canvas that the lazily-loaded Three.js
 * runtime (src/lab/index.ts) draws into, an HTML overlay that renders
 * instantly, and six accessible panels built from the same content as the
 * page sections. Everything here is server-rendered; src/lab/ui.ts wires it.
 */
interface Props {
  featured: CollectionEntry<"work">;
  projects: CollectionEntry<"work">[];
}
const { featured, projects } = Astro.props;

// Optimised texture sources for the scene. Same-origin URLs, so the
// TextureLoader needs no CORS setup.
const screen = await getImage({ src: featured.data.screenshot, width: 1024, format: "webp", quality: 80 });
const face = await getImage({ src: portrait, width: 512, format: "webp", quality: 80 });
const thumbs = await Promise.all(
  projects.map((p) => getImage({ src: p.data.screenshot, width: 320, format: "webp", quality: 70 })),
);

const troubleshooting = services.find((s) => s.icon === "wrench");
const hosting = services.find((s) => s.icon === "server");
const otherServices = services.filter((s) => s !== hosting);
---

<section
  id="lab"
  data-lab
  data-lab-only
  data-lab-state="idle"
  data-screen-src={screen.src}
  data-portrait-src={face.src}
  data-thumb-srcs={JSON.stringify(thumbs.map((t) => t.src))}
  class="relative h-dvh w-full overflow-hidden bg-background"
  aria-label="Interactive laboratory"
>
  <canvas data-lab-canvas aria-hidden="true" tabindex="-1" class="lab-canvas absolute inset-0 h-full w-full"></canvas>
  <p class="sr-only">
    This page is an illustrated inventor's laboratory. Each station in the room opens part of the portfolio. Use the
    station buttons below to open the same content, or switch to the page view.
  </p>

  <!-- Intro overlay: visible immediately, before any 3D code loads. -->
  <div data-lab-overlay class="lab-overlay pointer-events-none absolute inset-0 z-10 flex flex-col justify-between">
    <div class="lab-intro pointer-events-auto mx-auto w-full max-w-280 px-5 pt-24 sm:px-6 lg:pt-28">
      <div class="lab-intro-card max-w-lg rounded-card border border-border/80 bg-background/85 p-5 backdrop-blur-sm sm:p-6">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">{site.name} — {site.role}</p>
        <h1 class="mt-3 text-3xl font-semibold leading-[1.1] tracking-tight sm:text-4xl">{intro.headline}</h1>
        <p data-lab-intro-copy class="mt-3 text-sm leading-relaxed text-muted sm:text-base">{intro.paragraph}</p>
        <div class="mt-5 flex flex-wrap items-center gap-3">
          <Button href="#contact" data-station-link="comms">
            Discuss your project
            <ArrowRight class="size-4" aria-hidden="true" />
          </Button>
          <ModeSwitch />
        </div>
        <div data-lab-loading class="mt-4 flex items-center gap-3 text-xs text-muted" aria-live="polite">
          <progress data-lab-progress class="lab-progress h-1.5 w-28" aria-label="Loading the lab"></progress>
          <span data-lab-loading-text>Warming up the lab…</span>
        </div>
        <p data-lab-notice class="mt-4 text-sm text-muted" hidden></p>
      </div>
    </div>

    <div class="pointer-events-auto mx-auto w-full max-w-280 px-5 pb-5 sm:px-6 sm:pb-6">
      <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.2em] text-muted">Stations</p>
      <StationList class="lab-station-list" />
      <p data-lab-status class="sr-only" aria-live="polite"></p>
    </div>
  </div>

  <!-- Station panels (readable HTML, same sources as the page sections) -->
  <StationPanel id="console">
    <p class="text-sm text-muted">{featured.data.statusLabel} · {featured.data.role}</p>
    <p class="mt-3 leading-relaxed text-muted">{featured.data.summary}</p>
    <div class="mt-4 overflow-hidden rounded-card border border-border">
      <Image
        src={featured.data.screenshot}
        alt={featured.data.screenshotAlt}
        widths={[400, 800]}
        sizes="(max-width: 768px) calc(100vw - 2.5rem), 400px"
        loading="lazy"
        class="aspect-16/10 w-full object-cover object-top"
      />
    </div>
    <div class="mt-4 flex flex-wrap gap-2">
      {featured.data.stack.map((tag) => <Tag>{tag}</Tag>)}
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <Button href={`/work/${featured.id}`}>
        Read the case study
        <ArrowRight class="size-4" aria-hidden="true" />
      </Button>
      {
        featured.data.liveUrl && (
          <Button href={featured.data.liveUrl} external variant="secondary">
            Open {featured.data.title}
            <ArrowUpRight class="size-4 text-muted" aria-hidden="true" />
          </Button>
        )
      }
    </div>
  </StationPanel>

  <StationPanel id="experiments">
    <p class="text-sm leading-relaxed text-muted">
      WordPress and WooCommerce sites for businesses in Germany and Spain. I handled development; design came from
      {site.designer}.
    </p>
    <div class="mt-6 grid gap-8">
      {
        projects.map((project) => (
          <div class="relative">
            <ProjectCard project={project} />
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-muted">
      More work available on request —{" "}
      <a href={`mailto:${site.email}`} class="text-accent underline-offset-4 hover:underline">just ask</a>.
    </p>
  </StationPanel>

  <StationPanel id="repair">
    {troubleshooting && <p class="leading-relaxed text-muted">{troubleshooting.description}</p>}
    <p class="mt-6 font-mono text-xs uppercase tracking-[0.2em] text-muted">How a fix goes</p>
    <ol class="mt-3 space-y-4">
      {
        troubleshootingSteps.map((step, i) => (
          <li class="flex gap-3">
            <span class="font-mono text-sm text-accent" aria-hidden="true">
              0{i + 1}
            </span>
            <div>
              <h3 class="text-sm font-medium">{step.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="mt-6 text-sm text-muted">
      Something broken right now?{" "}
      <button type="button" data-station-link="comms" class="text-accent underline-offset-4 hover:underline">
        Tell me what it's doing
      </button>
      .
    </p>
  </StationPanel>

  <StationPanel id="servers">
    <div class="space-y-5">
      {
        [hosting, ...otherServices].filter(Boolean).map((service) => (
          <div>
            <h3 class="text-base font-medium">{service!.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">{service!.description}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-muted">{engagementLine}</p>
  </StationPanel>

  <StationPanel id="notebook">
    <div class="flex items-start gap-4">
      <Image
        src={portrait}
        alt={`Portrait of ${site.person}`}
        width={240}
        densities={[1, 2]}
        loading="lazy"
        class="aspect-4/5 w-24 shrink-0 rounded-card border border-border object-cover object-top sm:w-28"
      />
      <div class="space-y-3 text-sm leading-relaxed text-muted">
        {aboutParagraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <p class="mt-6 font-mono text-xs uppercase tracking-[0.2em] text-muted">How I work</p>
    <ol class="mt-3 space-y-3">
      {
        processSteps.map((step, i) => (
          <li class="flex gap-3">
            <span class="font-mono text-sm text-accent" aria-hidden="true">
              0{i + 1}
            </span>
            <div>
              <h3 class="text-sm font-medium">{step.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="mt-6 flex flex-wrap gap-2">
      {stack.map((item) => <Tag>{item}</Tag>)}
    </div>
    <a
      href={site.resume}
      class="mt-6 inline-flex min-h-11 w-fit items-center gap-2 rounded-button border border-border px-4 py-2.5 text-sm font-medium transition-colors hover:border-border-strong hover:bg-surface"
    >
      <Download class="size-4" aria-hidden="true" />
      Download résumé
    </a>
  </StationPanel>

  <StationPanel id="comms">
    <p class="text-sm leading-relaxed text-muted">
      A new site, a web app, or something broken on WordPress: send a message and I'll get back to you {site.responseTime}.
    </p>
    <div class="mt-5">
      <ContactForm idPrefix="lab" />
    </div>
    <p class="mt-6 font-mono text-xs uppercase tracking-[0.2em] text-muted">Helpful to include</p>
    <ul class="mt-2 space-y-1 text-sm text-muted">
      {contactHelp.map((item) => <li>{item}</li>)}
    </ul>
    <p class="mt-6 font-mono text-xs uppercase tracking-[0.2em] text-muted">Direct</p>
    <div class="mt-2 flex flex-col gap-2">
      <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 py-1 text-sm text-foreground underline-offset-4 hover:underline">
        <Mail class="size-4 text-muted" aria-hidden="true" />
        {site.email}
      </a>
      <a href={site.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 py-1 text-sm text-muted transition-colors hover:text-foreground">
        <GithubIcon />
        github.com/DexterDevLab
      </a>
    </div>
  </StationPanel>
</section>

<script>
  import { initLabUi } from "@/lab/ui";

  const root = document.querySelector<HTMLElement>("[data-lab]");
  if (root) {
    initLabUi(root, { boot: () => import("@/lab/index") });
  }
</script>
