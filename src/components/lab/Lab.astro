---
import { Image, getImage } from "astro:assets";
import { ArrowDown, ArrowRight, ArrowUpRight, ChevronDown, Download, Mail, Minus, Plus, RotateCcw, RotateCw, Settings2, Undo2 } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import Button from "@/components/ui/Button.astro";
import Tag from "@/components/ui/Tag.astro";
import GithubIcon from "@/components/ui/GithubIcon.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ContactForm from "@/components/ContactForm.astro";
import StationList from "./StationList.astro";
import StationPanel from "./StationPanel.astro";
import ModeSwitch from "./ModeSwitch.astro";
import portrait from "@/assets/portrait.jpg";
import logoUrl from "@/assets/logo.svg?url";
import { site } from "@/data/site";
import { services, engagementLine } from "@/data/services";
import { processSteps } from "@/data/process";
import { aboutParagraphs, contactHelp, intro, stack, troubleshootingSteps } from "@/data/about";

/**
 * The interactive laboratory as the page hero. Layout:
 *  - narrow screens: a column — compact intro / the 3D stage / station buttons;
 *  - md and up: the stage fills the hero and the intro + controls float over it.
 * The canvas is sized to the stage element. The page continues below, so
 * the hint says so; station panels still open as overlays.
 */
interface Props {
  featured: CollectionEntry<"work">;
  projects: CollectionEntry<"work">[];
}
const { featured, projects } = Astro.props;

const screen = await getImage({ src: featured.data.screenshot, width: 1024, format: "webp", quality: 80 });
const face = await getImage({ src: portrait, width: 512, format: "webp", quality: 80 });
const thumbs = await Promise.all(
  projects.map((p) => getImage({ src: p.data.screenshot, width: 320, format: "webp", quality: 70 })),
);

const troubleshooting = services.find((s) => s.icon === "wrench");
const hosting = services.find((s) => s.icon === "server");
const otherServices = services.filter((s) => s !== hosting);
---

<section
  id="lab"
  data-lab
  data-lab-only
  data-lab-state="idle"
  data-screen-src={screen.src}
  data-portrait-src={face.src}
  data-thumb-srcs={JSON.stringify(thumbs.map((t) => t.src))}
  data-logo-src={logoUrl}
  class="relative grid w-full grid-cols-1 grid-rows-[auto_auto_auto] overflow-hidden border-b-2 border-border-strong bg-background grid-floor pt-16 lg:min-h-svh lg:grid-cols-[calc(var(--edge)+25rem)_minmax(0,1fr)] lg:grid-rows-[minmax(0,1fr)_auto]"
  aria-label="Interactive laboratory"
>
  <span id="top" class="absolute top-0"></span>

  <!-- 1. Introduction (left column from lg) -->
  <div
    data-lab-intro
    class="lab-intro z-10 self-center px-5 pt-6 pb-4 sm:px-6 lg:py-5 lg:pr-6 lg:pl-[var(--edge)]"
  >
    <div data-lab-intro-text>
      <p class="label-mono inline-flex items-center gap-2 text-teal-deep">
        <span class="led bg-orange" aria-hidden="true"></span>
        {site.name} — {site.role}
      </p>
      <h1 class="display mt-3 text-[1.9rem] sm:text-4xl lg:text-[clamp(2.2rem,1.4vw+1.4rem,2.9rem)]">
        Websites and web apps,<br class="hidden lg:block" /> built and maintained.
      </h1>
      <p data-lab-intro-copy class="mt-3 max-w-md text-sm leading-relaxed text-foreground/85 sm:text-base">{intro.short}</p>
    </div>
    <div class="mt-5 flex flex-wrap items-center gap-2 sm:gap-3">
      <Button href="#contact" data-station-link="comms" size="sm">
        Discuss your project
        <ArrowRight class="size-4" aria-hidden="true" />
      </Button>
      <ModeSwitch />
    </div>
    <div data-lab-loading class="mt-3 flex items-center gap-3 text-xs text-muted" aria-live="polite">
      <progress data-lab-progress class="lab-progress h-1.5 w-28" aria-label="Loading the lab"></progress>
      <span data-lab-loading-text>Warming up the lab…</span>
    </div>
    <p data-lab-notice class="mt-3 text-sm text-muted" hidden></p>
    <div class="mt-6 hidden flex-col items-start gap-3 lg:flex">
      <p data-lab-hint class="hint-chip">
        Drag to rotate · <kbd>⌘</kbd>/<kbd>Ctrl</kbd> + scroll to zoom
      </p>
      <a href="#panda-central" class="btn btn-sm">
        Scroll to read
        <ArrowDown class="size-4" aria-hidden="true" />
      </a>
    </div>
  </div>

  <!-- 2. The room (right column from lg): the canvas is sized to this element -->
  <div data-lab-stage class="lab-stage relative">
    <canvas data-lab-canvas aria-hidden="true" tabindex="-1" class="lab-canvas absolute inset-0 h-full w-full"></canvas>
  </div>
  <p class="sr-only">
    This page opens with an illustrated inventor's laboratory you can rotate. Each station in the room opens part of
    the portfolio, and the same content continues below as a normal page. Use the station buttons, the rotate buttons,
    or simply scroll.
  </p>

  <!-- 3. Station and view controls along the bottom -->
  <div data-lab-hud class="lab-hud relative z-10 border-t-2 border-border-strong bg-surface lg:col-span-2">
    <div class="flex w-full flex-wrap items-center gap-x-6 gap-y-3 px-5 py-3 sm:px-6 lg:px-[var(--edge)]">
      <StationList class="lab-station-list" />
      <div class="flex flex-wrap items-center gap-2 lg:ml-auto">
        <details data-view-controls class="group/vc">
          <summary class="btn btn-sm cursor-pointer select-none">
            <Settings2 class="size-4" aria-hidden="true" />
            View controls
            <ChevronDown class="size-3.5 transition-transform group-open/vc:rotate-180" aria-hidden="true" />
          </summary>
          <div class="mt-2 flex flex-wrap gap-1.5 md:mt-0" role="group" aria-label="View controls">
            <button type="button" data-lab-rotate="left" aria-label="Rotate the room left" class="btn btn-sm size-10 px-0">
              <RotateCcw class="size-4" aria-hidden="true" />
            </button>
            <button type="button" data-lab-rotate="right" aria-label="Rotate the room right" class="btn btn-sm size-10 px-0">
              <RotateCw class="size-4" aria-hidden="true" />
            </button>
            <button type="button" data-lab-zoom="in" aria-label="Zoom in" class="btn btn-sm size-10 px-0">
              <Plus class="size-4" aria-hidden="true" />
            </button>
            <button type="button" data-lab-zoom="out" aria-label="Zoom out" class="btn btn-sm size-10 px-0">
              <Minus class="size-4" aria-hidden="true" />
            </button>
            <button type="button" data-lab-reset class="btn btn-sm">
              <Undo2 class="size-4" aria-hidden="true" />
              Reset view
            </button>
          </div>
        </details>
        <p class="hint-chip hidden sm:inline-flex lg:hidden">
          Drag to rotate · <kbd>⌘</kbd>/<kbd>Ctrl</kbd> + scroll to zoom
        </p>
      </div>
    </div>
    <p data-lab-status class="sr-only" aria-live="polite"></p>
  </div>

  <!-- Station panels (readable HTML, same sources as the page sections) -->
  <StationPanel id="console">
    <p class="text-sm text-muted">{featured.data.statusLabel} · {featured.data.role}</p>
    <p class="mt-3 leading-relaxed text-muted">{featured.data.summary}</p>
    <div class="bezel mt-4 overflow-hidden">
      <div class="m-1.5 overflow-hidden rounded-[10px]">
        <Image
          src={featured.data.screenshot}
          alt={featured.data.screenshotAlt}
          widths={[400, 800]}
          sizes="(max-width: 768px) calc(100vw - 2.5rem), 400px"
          loading="lazy"
          class="aspect-16/10 w-full object-cover object-top"
        />
      </div>
    </div>
    <div class="mt-4 flex flex-wrap gap-2">
      {featured.data.stack.map((tag) => <Tag>{tag}</Tag>)}
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <Button href={`/work/${featured.id}`} size="sm">
        Read the case study
        <ArrowRight class="size-4" aria-hidden="true" />
      </Button>
      {
        featured.data.liveUrl && (
          <Button href={featured.data.liveUrl} external variant="secondary" size="sm">
            Open {featured.data.title}
            <ArrowUpRight class="size-4 text-muted" aria-hidden="true" />
          </Button>
        )
      }
    </div>
  </StationPanel>

  <StationPanel id="experiments">
    <p class="text-sm leading-relaxed text-muted">
      WordPress and WooCommerce sites for businesses in Germany and Spain. I handled development; design came from
      {site.designer}.
    </p>
    <div class="mt-6 grid gap-8">
      {
        projects.map((project, i) => (
          <div class="relative">
            <ProjectCard project={project} index={i + 1} />
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-muted">
      More work available on request —{" "}
      <a href={`mailto:${site.email}`} class="font-medium text-accent underline-offset-4 hover:underline">just ask</a>.
    </p>
  </StationPanel>

  <StationPanel id="repair">
    {troubleshooting && <p class="leading-relaxed text-muted">{troubleshooting.description}</p>}
    <p class="label-mono mt-6 text-muted">How a fix goes</p>
    <ol class="mt-3 space-y-4">
      {
        troubleshootingSteps.map((step, i) => (
          <li class="flex gap-3">
            <span class="outlined-sm flex size-7 shrink-0 items-center justify-center rounded-full bg-orange font-mono text-xs font-bold text-[#2b2b30]" aria-hidden="true">
              {i + 1}
            </span>
            <div>
              <h3 class="text-sm font-bold">{step.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="mt-6 text-sm text-muted">
      Something broken right now?{" "}
      <button type="button" data-station-link="comms" class="font-medium text-accent underline-offset-4 hover:underline">
        Tell me what it's doing
      </button>
      .
    </p>
  </StationPanel>

  <StationPanel id="servers">
    <div class="space-y-5">
      {
        [hosting, ...otherServices].filter(Boolean).map((service) => (
          <div>
            <h3 class="text-base font-bold">{service!.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">{service!.description}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-muted">{engagementLine}</p>
  </StationPanel>

  <StationPanel id="notebook">
    <div class="flex items-start gap-4">
      <Image
        src={portrait}
        alt={`Portrait of ${site.person}`}
        width={240}
        densities={[1, 2]}
        loading="lazy"
        class="aspect-4/5 w-24 shrink-0 rounded-[6px] border-2 border-border-strong object-cover object-top sm:w-28"
      />
      <div class="space-y-3 text-sm leading-relaxed text-muted">
        {aboutParagraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <p class="label-mono mt-6 text-muted">How I work</p>
    <ol class="mt-3 space-y-3">
      {
        processSteps.map((step, i) => (
          <li class="flex gap-3">
            <span class="font-mono text-sm font-bold text-orange-deep" aria-hidden="true">
              0{i + 1}
            </span>
            <div>
              <h3 class="text-sm font-bold">{step.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="mt-6 flex flex-wrap gap-2">
      {stack.map((item) => <Tag>{item}</Tag>)}
    </div>
    <Button href={site.resume} variant="secondary" size="sm" class="mt-6">
      <Download class="size-4" aria-hidden="true" />
      Download résumé
    </Button>
  </StationPanel>

  <StationPanel id="comms">
    <p class="text-sm leading-relaxed text-muted">
      A new site, a web app, or something broken on WordPress: send a message and I'll get back to you {site.responseTime}.
    </p>
    <div class="mt-5">
      <ContactForm idPrefix="lab" />
    </div>
    <p class="label-mono mt-6 text-muted">Helpful to include</p>
    <ul class="mt-2 space-y-1 text-sm text-muted">
      {contactHelp.map((item) => <li>{item}</li>)}
    </ul>
    <p class="label-mono mt-6 text-muted">Direct</p>
    <div class="mt-2 flex flex-col gap-2">
      <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 py-1 text-sm font-medium text-foreground underline-offset-4 hover:underline">
        <Mail class="size-4 text-muted" aria-hidden="true" />
        {site.email}
      </a>
      <a href={site.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 py-1 text-sm text-muted transition-colors hover:text-foreground">
        <GithubIcon />
        github.com/DexterDevLab
      </a>
    </div>
  </StationPanel>
</section>

<script>
  import { initLabUi } from "@/lab/ui";

  const root = document.querySelector<HTMLElement>("[data-lab]");
  if (root) {
    initLabUi(root, { boot: () => import("@/lab/index") });
  }
</script>
