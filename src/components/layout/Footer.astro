---
import { Mail, Download } from "@lucide/astro";
import GithubIcon from "@/components/ui/GithubIcon.astro";
import Container from "@/components/ui/Container.astro";
import { navLinks, site } from "@/data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-border py-10">
  <Container class="flex flex-col items-center gap-6 md:flex-row md:justify-between">
    <div class="flex flex-col items-center gap-1 md:items-start">
      <span class="font-mono text-sm font-semibold">{site.name}</span>
      <p class="text-xs text-muted">© {year} {site.shortPerson}. Based in the Philippines, working worldwide.</p>
    </div>

    <nav aria-label="Footer" class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
      {
        navLinks.map((link) => (
          <a href={link.href} class="py-2 text-sm text-muted transition-colors hover:text-foreground">
            {link.label}
          </a>
        ))
      }
      <a href={site.resume} class="inline-flex items-center gap-1.5 py-2 text-sm text-muted transition-colors hover:text-foreground">
        <Download class="size-3.5" aria-hidden="true" />
        Résumé
      </a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub profile"
        class="inline-flex size-11 items-center justify-center rounded-button border border-border text-muted transition-colors hover:border-border-strong hover:text-foreground"
      >
        <GithubIcon />
      </a>
      <a
        href={`mailto:${site.email}`}
        aria-label="Email me"
        class="inline-flex size-11 items-center justify-center rounded-button border border-border text-muted transition-colors hover:border-border-strong hover:text-foreground"
      >
        <Mail class="size-4" aria-hidden="true" />
      </a>
    </div>
  </Container>
</footer>
