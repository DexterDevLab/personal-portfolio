---
import { Mail, Download } from "@lucide/astro";
import GithubIcon from "@/components/ui/GithubIcon.astro";
import Container from "@/components/ui/Container.astro";
import { navLinks, site } from "@/data/site";

const year = new Date().getFullYear();
---

<footer class="relative z-10 bg-[#2b2b30] py-10 text-[#f3eee4]">
  <Container class="flex flex-col items-center gap-6 md:flex-row md:justify-between">
    <div class="flex flex-col items-center gap-2 md:items-start">
      <span class="plate text-sm">{site.name}</span>
      <p class="text-xs text-[#b9b3a7]">© {year} {site.shortPerson}. Based in the Philippines, working worldwide.</p>
    </div>

    <nav aria-label="Footer" class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
      {
        navLinks.map((link) => (
          <a href={link.href} class="py-2 text-sm text-[#d8d2c6] transition-colors hover:text-white">
            {link.label}
          </a>
        ))
      }
      <a href={site.resume} class="inline-flex items-center gap-1.5 py-2 text-sm text-[#d8d2c6] transition-colors hover:text-white">
        <Download class="size-3.5" aria-hidden="true" />
        Résumé
      </a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub profile"
        class="inline-flex size-11 items-center justify-center rounded-button border-2 border-[#3d3d45] bg-[#1b1b1f] text-[#d8d2c6] transition-colors hover:border-teal hover:text-white"
      >
        <GithubIcon />
      </a>
      <a
        href={`mailto:${site.email}`}
        aria-label="Email me"
        class="inline-flex size-11 items-center justify-center rounded-button border-2 border-[#3d3d45] bg-[#1b1b1f] text-[#d8d2c6] transition-colors hover:border-teal hover:text-white"
      >
        <Mail class="size-4" aria-hidden="true" />
      </a>
    </div>
  </Container>
</footer>
