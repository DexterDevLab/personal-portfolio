---
import { X } from "@lucide/astro";
import { navLinks, site } from "@/data/site";
import ModeSwitch from "@/components/lab/ModeSwitch.astro";

interface Props {
  lab?: boolean;
}
const { lab = false } = Astro.props;
---

<!-- Native <dialog>: focus trap, Esc to close, inert page behind, ::backdrop. -->
<dialog
  data-mobile-nav
  aria-label="Menu"
  class="fixed inset-y-0 right-0 left-auto m-0 hidden h-dvh max-h-none w-72 max-w-[85vw] flex-col border-l border-border bg-background p-6 text-foreground open:flex"
>
  <div class="flex items-center justify-between">
    <span class="font-mono text-base font-semibold">{site.name}</span>
    <button
      type="button"
      aria-label="Close menu"
      data-mobile-nav-close
      class="inline-flex size-11 items-center justify-center rounded-button border border-border text-muted hover:text-foreground"
    >
      <X class="size-4" aria-hidden="true" />
    </button>
  </div>
  <div class="mt-8 flex flex-col gap-1">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-button px-3 py-3 text-base text-muted transition-colors hover:bg-surface hover:text-foreground"
        >
          {link.label}
        </a>
      ))
    }
    <a
      href={site.resume}
      class="rounded-button px-3 py-3 text-base text-muted transition-colors hover:bg-surface hover:text-foreground"
    >
      Résumé
    </a>
    {lab && <ModeSwitch class="mt-4 justify-center" />}
    <a
      href="/#contact"
      class="mt-2 inline-flex min-h-11 items-center justify-center rounded-button bg-accent-strong px-4 py-3 text-sm font-medium text-white"
    >
      Discuss your project
    </a>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-mobile-nav]");
  const openButton = document.querySelector<HTMLButtonElement>("[data-mobile-nav-open]");

  if (dialog && openButton) {
    const show = () => dialog.showModal();
    const hide = () => dialog.close();
    dialog.addEventListener("close", () => openButton.focus());

    openButton.addEventListener("click", show);
    dialog.querySelector("[data-mobile-nav-close]")?.addEventListener("click", hide);
    dialog.querySelectorAll("a").forEach((a) => a.addEventListener("click", hide));

    // Click on the backdrop closes the menu.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) hide();
    });
  }
</script>
