---
import { Menu } from "@lucide/astro";
import { navLinks, site } from "@/data/site";
import ThemeToggle from "./ThemeToggle.astro";
import MobileNav from "./MobileNav.astro";
import ModeSwitch from "@/components/lab/ModeSwitch.astro";

/**
 * Control strip: a solid bar with a bottom outline, the wordmark on a
 * nameplate, text navigation and one orange "go" button.
 */
interface Props {
  lab?: boolean;
}
const { lab = false } = Astro.props;
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 border-b-2 border-border-strong bg-background/95 backdrop-blur-sm"
>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-button focus:bg-orange focus:px-4 focus:py-2 focus:text-sm focus:text-ink"
  >
    Skip to content
  </a>
  <nav aria-label="Main" class="mx-auto flex h-16 w-full max-w-280 items-center justify-between gap-3 px-5 sm:px-6">
    <a href="/#top" class="plate text-sm" aria-label={`${site.name} — home`}>
      <span class="led bg-orange" aria-hidden="true"></span>
      {site.name}
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-1 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-button px-3 py-2 text-sm font-medium text-foreground/80 transition-colors hover:bg-surface-2 hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={site.resume}
        class="rounded-button px-3 py-2 text-sm font-medium text-foreground/80 transition-colors hover:bg-surface-2 hover:text-foreground"
      >
        Résumé
      </a>
      {lab && <ModeSwitch class="ml-2" />}
      <a href="/#contact" class="btn btn-primary btn-sm ml-2">Discuss your project</a>
      <ThemeToggle class="ml-2 size-10" />
    </div>

    <!-- Mobile nav -->
    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button
        type="button"
        aria-label="Open menu"
        data-mobile-nav-open
        class="btn btn-sm size-11 px-0"
      >
        <Menu class="size-4" aria-hidden="true" />
      </button>
    </div>
  </nav>
  <MobileNav lab={lab} />
</header>
