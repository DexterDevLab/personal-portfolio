---
import { Menu } from "@lucide/astro";
import { navLinks, site } from "@/data/site";
import ThemeToggle from "./ThemeToggle.astro";
import MobileNav from "./MobileNav.astro";
import ModeSwitch from "@/components/lab/ModeSwitch.astro";

interface Props {
  /** Show the lab/page switch (homepage only). */
  lab?: boolean;
}
const { lab = false } = Astro.props;
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-300 data-[scrolled]:border-border data-[scrolled]:bg-background/85 md:data-[scrolled]:backdrop-blur-md"
>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-button focus:bg-accent-strong focus:px-4 focus:py-2 focus:text-sm focus:text-white"
  >
    Skip to content
  </a>
  <nav aria-label="Main" class="mx-auto flex h-16 w-full max-w-280 items-center justify-between px-5 sm:px-6">
    <a href="/#top" class="font-mono text-base font-semibold tracking-tight">
      {site.name}
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-1 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-button px-3 py-2 text-sm text-muted transition-colors hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={site.resume}
        class="rounded-button px-3 py-2 text-sm text-muted transition-colors hover:text-foreground"
      >
        Résumé
      </a>
      {lab && <ModeSwitch class="ml-2" />}
      <a
        href="/#contact"
        class="ml-2 inline-flex min-h-10 items-center rounded-button bg-accent-strong px-4 py-2 text-sm font-medium text-white transition-opacity hover:opacity-90"
      >
        Discuss your project
      </a>
      <ThemeToggle class="ml-2 size-10" />
    </div>

    <!-- Mobile nav -->
    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button
        type="button"
        aria-label="Open menu"
        data-mobile-nav-open
        class="inline-flex size-11 items-center justify-center rounded-button border border-border text-muted transition-colors hover:text-foreground"
      >
        <Menu class="size-4" aria-hidden="true" />
      </button>
    </div>
  </nav>
  <MobileNav lab={lab} />
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    const update = () => header.toggleAttribute("data-scrolled", window.scrollY > 8);
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
