---
import type { CollectionEntry } from "astro:content";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Reveal from "@/components/Reveal.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { site } from "@/data/site";

interface Props {
  projects: CollectionEntry<"work">[];
}
const { projects } = Astro.props;
---

<Section id="work" class="border-t border-border">
  <SectionHeading
    eyebrow="Selected work"
    title="Client sites I've developed."
    description="WordPress and WooCommerce sites for businesses in Germany and Spain: a B2B shop, a rental platform, multilingual and showroom sites. I handled development; design came from my designer colleague."
  />
  <div class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project, i) => (
        <Reveal delay={(i % 3) * 0.06} class="relative">
          <ProjectCard project={project} />
        </Reveal>
      ))
    }
  </div>
  <Reveal delay={0.2}>
    <p class="mt-10 max-w-2xl text-sm text-muted">
      More work available on request —{" "}
      <a href={`mailto:${site.email}`} class="text-accent underline-offset-4 hover:underline">
        just ask
      </a>
      .
    </p>
  </Reveal>
</Section>
