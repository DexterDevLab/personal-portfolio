---
import type { CollectionEntry } from "astro:content";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Reveal from "@/components/Reveal.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { site } from "@/data/site";

/**
 * The experiment rack: the first two builds get wide frames on the top
 * shelf, the rest sit three across below. A shelf line runs under each row.
 */
interface Props {
  projects: CollectionEntry<"work">[];
}
const { projects } = Astro.props;
const top = projects.slice(0, 2);
const rest = projects.slice(2);
---

<Section id="work" tone="deep" class="border-b-2 border-border-strong">
  <SectionHeading
    eyebrow="Experiments · completed builds"
    title="Client sites I've developed."
    description="WordPress and WooCommerce sites for businesses in Germany and Spain: a B2B shop, a rental platform, multilingual and showroom sites. I handled development; design came from my designer colleague."
  />
  <div class="grid gap-x-8 gap-y-10 md:grid-cols-2">
    {
      top.map((project, i) => (
        <Reveal delay={i * 0.06} class="relative">
          <ProjectCard project={project} index={i + 1} wide />
        </Reveal>
      ))
    }
  </div>
  <div class="shelf my-10" aria-hidden="true"></div>
  <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
    {
      rest.map((project, i) => (
        <Reveal delay={(i % 3) * 0.06} class="relative">
          <ProjectCard project={project} index={i + 3} />
        </Reveal>
      ))
    }
  </div>
  <div class="shelf mt-10" aria-hidden="true"></div>
  <Reveal delay={0.2}>
    <p class="mt-8 max-w-2xl text-sm text-muted">
      More work available on request —{" "}
      <a href={`mailto:${site.email}`} class="font-medium text-accent underline-offset-4 hover:underline">
        just ask
      </a>
      .
    </p>
  </Reveal>
</Section>

<style>
  /* A wooden shelf edge, like the rack in the room */
  .shelf {
    height: 10px;
    border: 2px solid var(--line);
    border-radius: 4px;
    background: var(--teal);
    box-shadow: 0 4px 0 0 var(--shadow);
  }
</style>
