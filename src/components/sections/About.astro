---
import { Image } from "astro:assets";
import { Download } from "@lucide/astro";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Reveal from "@/components/Reveal.astro";
import Button from "@/components/ui/Button.astro";
import portrait from "@/assets/portrait.jpg";
import { site } from "@/data/site";
import { aboutParagraphs, stack } from "@/data/about";

/**
 * The lab notebook, open on the bench. Left page: the taped polaroid with a
 * handwritten caption, an index card of plain facts, the résumé. Right page:
 * the biography as numbered entries with margin labels, a sticky note, and
 * the tools as stickers. Index tabs on the page edge, a paper clip, page
 * numbers. Everything decorative is aria-hidden; the words are the real copy
 * from src/data/about.ts.
 */
const entries = ["Background", "How I work", "AI in the loop"];
const facts = [
  ["Base", "Philippines, working worldwide"],
  ["Experience", "10+ years building for the web"],
  ["Started with", "WordPress, now custom web apps too"],
  ["Works with", `${site.designer} on design`],
];
const tabs = ["Bio", "Tools", "CV"];
---

<Section id="about">
  <SectionHeading eyebrow="Lab notebook" title="A developer who sticks with the problem." />
  <Reveal>
    <div class="notebook outlined relative grid rounded-card md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]" data-notebook>
      <!-- index tabs on the right page edge -->
      <ul class="tabs" aria-hidden="true">
        {tabs.map((t) => <li class="tab">{t}</li>)}
      </ul>
      <!-- paper clip over the top-left corner -->
      <span class="clip" aria-hidden="true"></span>

      <!-- Left page -->
      <div class="paper page relative overflow-hidden rounded-t-card border-b-2 border-border-strong p-6 sm:p-8 md:rounded-l-card md:rounded-tr-none md:border-r-2 md:border-b-0">
        <!-- Decorative cover, opened by the choreography when the section comes into view -->
        <div class="cover" data-notebook-cover aria-hidden="true">
          <span class="cover-label label-mono">Lab notebook</span>
        </div>
        <p class="label-mono text-muted">Entry 00 · Who</p>
        <div class="polaroid relative mx-auto mt-5 w-full max-w-60 rotate-[-2.5deg]" data-notebook-photo>
          <span class="tape -top-3 left-5" aria-hidden="true"></span>
          <span class="tape -top-3 right-5" aria-hidden="true"></span>
          <Image
            src={portrait}
            alt={`Portrait of ${site.person}`}
            width={480}
            densities={[1, 2]}
            loading="lazy"
            class="aspect-4/5 w-full rounded-[4px] object-cover object-top"
          />
          <p class="handwritten mt-3 text-center" aria-hidden="true">{site.shortPerson}, at the bench</p>
        </div>
        <p class="sr-only">{site.person}, {site.role}, Philippines.</p>

        <dl class="facts mt-7">
          {
            facts.map(([k, v]) => (
              <div class="fact">
                <dt class="label-mono text-muted">{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-6 flex justify-center">
          <Button href={site.resume} variant="secondary" size="sm">
            <Download class="size-4" aria-hidden="true" />
            Download résumé
          </Button>
        </div>
        <span class="page-no left-6" aria-hidden="true">12</span>
      </div>

      <!-- Right page -->
      <div class="paper page relative overflow-hidden rounded-b-card p-6 sm:p-8 md:rounded-r-card md:rounded-bl-none md:pl-12">
        <div class="rings" aria-hidden="true"></div>
        <!-- sticky note, in the flow so it never covers the entries -->
        <div class="mb-5 flex justify-end" aria-hidden="true">
          <div class="sticky">
            <span class="handwritten">Ask me about WordPress fixes →</span>
          </div>
        </div>
        <ol class="entries">
          {
            aboutParagraphs.map((p, i) => (
              <li class="entry">
                <span class="label-mono entry-label text-muted">
                  Entry 0{i + 1} · {entries[i]}
                </span>
                <p class="text-base leading-[2rem] text-foreground/90">{p}</p>
              </li>
            ))
          }
        </ol>
        <p class="label-mono mt-8 text-muted">Tools I reach for</p>
        <ul class="stickers mt-3 flex flex-wrap gap-2">
          {stack.map((item) => <li class="sticker">{item}</li>)}
        </ul>
        <span class="page-no right-6" aria-hidden="true">13</span>
      </div>
    </div>
  </Reveal>
</Section>

<style>
  .notebook {
    background: var(--paper);
    margin-right: 1.5rem; /* room for the index tabs */
  }
  .page {
    background-color: var(--paper);
    background-image: linear-gradient(to bottom, transparent 31px, color-mix(in oklab, var(--blue) 18%, transparent) 32px);
    background-size: 100% 32px;
  }
  /* polaroid: a light frame with a deeper bottom edge, in both themes */
  .polaroid {
    padding: 0.6rem 0.6rem 0.9rem;
    background: #fffcf3;
    border: 2px solid var(--line);
    box-shadow: 4px 4px 0 0 var(--shadow);
  }
  .dark .polaroid {
    background: #f1ead8;
  }
  .handwritten {
    font-family: "Segoe Print", "Bradley Hand", "Marker Felt", "Comic Sans MS", cursive;
    font-size: 0.95rem;
    color: #3b63e6;
    transform: rotate(-1deg);
  }
  .tape {
    position: absolute;
    width: 3.5rem;
    height: 1.1rem;
    background: color-mix(in oklab, var(--teal) 55%, transparent);
    border: 2px solid var(--line);
    transform: rotate(-6deg);
    z-index: 1;
  }
  .tape:last-of-type {
    transform: rotate(5deg);
  }
  /* index card of facts */
  .facts {
    border: 2px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    padding: 0.25rem 0.9rem;
    box-shadow: 3px 3px 0 0 var(--shadow);
  }
  .fact {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.55rem 0;
    font-size: 0.9rem;
    border-top: 1px dashed var(--line-soft);
  }
  .fact:first-child {
    border-top: 0;
  }
  .fact dt {
    padding-top: 0.15rem;
  }
  /* numbered entries with a margin label */
  .entries {
    display: grid;
    gap: 1.25rem;
  }
  .entry {
    position: relative;
    padding-left: 0.9rem;
    border-left: 3px solid var(--teal);
  }
  .entry-label {
    display: block;
    margin-bottom: 0.25rem;
  }
  /* sticky note at the top of the right page */
  .sticky {
    width: 9.5rem;
    padding: 0.7rem 0.8rem 0.9rem;
    background: var(--orange);
    border: 2px solid var(--line);
    transform: rotate(3deg);
    box-shadow: 3px 3px 0 0 var(--shadow);
    line-height: 1.3;
  }
  .sticky .handwritten {
    color: #25252b;
    font-size: 0.85rem;
  }
  /* stickers: chunkier than the usual tags */
  .sticker {
    padding: 0.3rem 0.65rem;
    border: 2px solid var(--line);
    border-radius: 999px;
    background: var(--teal-soft);
    color: var(--ink);
    font-family: var(--font-geist-mono);
    font-size: 0.75rem;
    box-shadow: 2px 2px 0 0 var(--shadow);
    transform: rotate(-1deg);
  }
  .sticker:nth-child(even) {
    transform: rotate(1.2deg);
    background: color-mix(in oklab, var(--orange) 30%, var(--paper));
  }
  .page-no {
    position: absolute;
    bottom: 0.6rem;
    font-family: var(--font-geist-mono);
    font-size: 0.7rem;
    color: var(--ink-soft);
  }
  /* index tabs on the right edge */
  .tabs {
    position: absolute;
    top: 2.5rem;
    right: -1.5rem;
    display: none;
    flex-direction: column;
    gap: 0.6rem;
    z-index: 1;
  }
  .tab {
    width: 1.5rem;
    padding: 0.7rem 0.2rem;
    border: 2px solid var(--line);
    border-left: 0;
    border-radius: 0 8px 8px 0;
    background: var(--teal);
    color: #0f2a27;
    font-family: var(--font-geist-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    box-shadow: 3px 3px 0 0 var(--shadow);
  }
  .tab:nth-child(2) {
    background: var(--orange);
  }
  .tab:nth-child(3) {
    background: var(--paper);
    color: var(--ink);
  }
  /* paper clip over the top-left corner */
  .clip {
    position: absolute;
    top: -1.1rem;
    left: 2.2rem;
    width: 1.1rem;
    height: 3.2rem;
    border: 3px solid #9aa3ad;
    border-radius: 999px;
    z-index: 2;
  }
  .clip::after {
    content: "";
    position: absolute;
    inset: 0.55rem 0.2rem 0.3rem;
    border: 3px solid #9aa3ad;
    border-top: 0;
    border-radius: 0 0 999px 999px;
  }
  /* ring binding along the spine on wide screens */
  @media (min-width: 768px) {
    .tabs {
      display: flex;
    }
    .rings {
      position: absolute;
      top: 0;
      bottom: 0;
      left: -0.6rem;
      width: 1.2rem;
      background-image: radial-gradient(circle, var(--line) 0 4px, transparent 5px);
      background-size: 1.2rem 2.4rem;
      background-position: 0 1.2rem;
      background-repeat: repeat-y;
    }
  }
  @media (max-width: 767px) {
    .notebook {
      margin-right: 0;
    }
    .sticky {
      transform: rotate(-1.5deg);
    }
  }
</style>
