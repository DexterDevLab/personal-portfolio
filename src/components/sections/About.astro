---
import { Image } from "astro:assets";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Reveal from "@/components/Reveal.astro";
import Tag from "@/components/ui/Tag.astro";
import portrait from "@/assets/portrait.jpg";
import { site } from "@/data/site";
import { aboutParagraphs, stack } from "@/data/about";
---

<Section id="about" class="border-t border-border">
  <SectionHeading eyebrow="About" title="A developer who sticks with the problem." />
  <div class="grid items-start gap-10 md:grid-cols-[240px_1fr]">
    <Reveal>
      <Image
        src={portrait}
        alt={`Portrait of ${site.person}`}
        width={480}
        densities={[1, 2]}
        loading="lazy"
        class="aspect-4/5 w-full max-w-60 rounded-card border border-border object-cover object-top"
      />
    </Reveal>
    <Reveal delay={0.08}>
      <div class="max-w-2xl space-y-4 text-base leading-relaxed text-muted">
        {aboutParagraphs.map((p) => <p>{p}</p>)}
      </div>
      <div class="mt-6 flex flex-wrap gap-2">
        {stack.map((item) => <Tag>{item}</Tag>)}
      </div>
    </Reveal>
  </div>
</Section>
