---
import { LayoutTemplate, Wrench, AppWindow, Server } from "@lucide/astro";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Reveal from "@/components/Reveal.astro";
import { engagementLine, services, type ServiceIcon } from "@/data/services";

const icons: Record<ServiceIcon, typeof Wrench> = {
  layout: LayoutTemplate,
  wrench: Wrench,
  app: AppWindow,
  server: Server,
};
---

<Section id="services" class="border-t border-border">
  <SectionHeading
    eyebrow="Services"
    title="Build it, fix it, keep it running."
    description="Four things I do for clients, from a first build to the maintenance that comes after."
  />
  <div class="grid gap-4 sm:grid-cols-2">
    {
      services.map((service, i) => {
        const Icon = icons[service.icon];
        return (
          <Reveal delay={(i % 2) * 0.06}>
            <div class="h-full rounded-card border border-border bg-surface p-6 transition-colors hover:border-border-strong">
              <Icon class="mb-4 size-5 text-accent" aria-hidden="true" />
              <h3 class="text-base font-medium">{service.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{service.description}</p>
            </div>
          </Reveal>
        );
      })
    }
  </div>
  <Reveal delay={0.2}>
    <p class="mt-8 max-w-2xl text-sm text-muted">{engagementLine}</p>
  </Reveal>
</Section>
