---
import { Image } from "astro:assets";
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Section from "@/components/ui/Section.astro";
import Tag from "@/components/ui/Tag.astro";
import Reveal from "@/components/Reveal.astro";
import NetworkArt from "@/components/decor/NetworkArt.astro";
import { featuredCopy } from "@/data/about";

/**
 * Panda Central as the lab's main control system: a large instrument display
 * with numbered markers on the real dashboard and a legend that only names
 * what is actually on the screenshot.
 */
interface Props {
  project: CollectionEntry<"work">;
}
const { project } = Astro.props;
const { data } = project;
const liveHost = data.liveUrl ? new URL(data.liveUrl).host : undefined;

// Positions are percentages of the screenshot (top 16:10 crop of the dashboard).
const markers = [
  { n: 1, x: 14, y: 14, label: "Managed sites overview", note: "every connected site and its pending core, plugin and theme updates" },
  { n: 2, x: 48, y: 36, label: "Queue health", note: "background update jobs, waiting counts and failures in the last window" },
  { n: 3, x: 78, y: 64, label: "Recent activity", note: "per-site log of update batches and connector diagnostics" },
];
---

<Section id="panda-central" tone="ink" class="border-y-2 border-border-strong">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,3fr)] lg:items-start lg:gap-14">
    <Reveal>
      <div class="bezel overflow-hidden">
        <div class="flex h-10 items-center gap-3 border-b-2 border-[#3d3d45] px-4" aria-hidden="true">
          <span class="led bg-teal"></span>
          <span class="font-mono text-[11px] tracking-[0.2em] text-[#b9b3a7] uppercase">Main control system</span>
          <span class="ml-auto truncate font-mono text-[11px] text-[#b9b3a7]">{liveHost}</span>
        </div>
        <div class="relative m-1.5 overflow-hidden rounded-[10px] bg-[#101014]">
          <Image
            src={data.screenshot}
            alt={data.screenshotAlt}
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 1023px) calc(100vw - 2.5rem), 700px"
            loading="lazy"
            class="aspect-16/10 w-full object-cover object-top"
          />
          {
            markers.map((m) => (
              <span
                class="absolute flex size-7 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-[#2b2b30] bg-orange font-mono text-xs font-bold text-[#2b2b30] shadow-[2px_2px_0_0_#2b2b30]"
                style={`left:${m.x}%; top:${m.y}%`}
                aria-hidden="true"
              >
                {m.n}
              </span>
            ))
          }
        </div>
      </div>
      <ol class="mt-4 grid gap-2 sm:grid-cols-3">
        {
          markers.map((m) => (
            <li class="flex gap-2 text-sm">
              <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-orange font-mono text-[10px] font-bold text-[#2b2b30]">
                {m.n}
              </span>
              <span>
                <span class="font-semibold text-[#f3eee4]">{m.label}</span>
                <span class="text-[#b9b3a7]"> — {m.note}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </Reveal>

    <Reveal delay={0.08}>
      <svg class="signal-stub" viewBox="0 0 40 44" data-signal-port="panda-central" aria-hidden="true">
        <path class="cable-outline" d="M20 -4v22" />
        <path class="cable-core" d="M20 -4v22" />
        <circle class="port-led" cx="20" cy="30" r="6" />
      </svg>
      <Eyebrow class="mb-3 !text-[#b9b3a7]" tone="orange">Featured project</Eyebrow>
      <h2 class="display text-[2rem] md:text-[2.8rem]">{data.title}</h2>
      <p class="mt-3 text-sm text-[#b9b3a7]">
        {data.statusLabel ?? "Live"} · {data.role}
      </p>
      <h3 class="mt-7 text-base font-semibold">{featuredCopy.problemTitle}</h3>
      <p class="mt-2 leading-relaxed text-[#d8d2c6]">{featuredCopy.problem}</p>
      <h3 class="mt-6 text-base font-semibold">{featuredCopy.builtTitle}</h3>
      <p class="mt-2 leading-relaxed text-[#d8d2c6]">{featuredCopy.built}</p>
      <div class="mt-5 flex flex-wrap gap-2">
        {data.stack.map((tag) => <Tag>{tag}</Tag>)}
      </div>
      <div class="mt-7 flex flex-wrap gap-3">
        <Button href={`/work/${project.id}`}>
          Read the case study
          <ArrowRight class="size-4" aria-hidden="true" />
        </Button>
        {
          data.liveUrl && (
            <Button href={data.liveUrl} external variant="secondary" class="!bg-[#1b1b1f] !text-[#f3eee4]">
              Open {data.title}
              <ArrowUpRight class="size-4" aria-hidden="true" />
            </Button>
          )
        }
      </div>
      <div class="mt-8 max-w-[300px] rounded-[12px] border-2 border-[#3d3d45] bg-[#1b1b1f] p-3" data-network-frame>
        <NetworkArt />
      </div>
    </Reveal>
  </div>
</Section>
