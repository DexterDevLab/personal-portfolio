---
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Section from "@/components/ui/Section.astro";
import Tag from "@/components/ui/Tag.astro";
import Reveal from "@/components/Reveal.astro";
import { featuredCopy } from "@/data/about";

interface Props {
  project: CollectionEntry<"work">;
}
const { project } = Astro.props;
const { data } = project;
---

<Section id="panda-central" compact class="border-t border-border">
  <Reveal>
    <div class="grid gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-14">
      <div>
        <Eyebrow class="mb-3">Featured project</Eyebrow>
        <h2 class="text-3xl font-semibold leading-tight md:text-4xl">{data.title}</h2>
        <p class="mt-3 text-sm text-muted">
          {data.statusLabel ?? "Live"} · {data.role}
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          {data.stack.map((tag) => <Tag>{tag}</Tag>)}
        </div>
      </div>
      <div class="max-w-2xl">
        <h3 class="text-base font-medium">{featuredCopy.problemTitle}</h3>
        <p class="mt-2 leading-relaxed text-muted">{featuredCopy.problem}</p>
        <h3 class="mt-6 text-base font-medium">{featuredCopy.builtTitle}</h3>
        <p class="mt-2 leading-relaxed text-muted">{featuredCopy.built}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <Button href={`/work/${project.id}`}>
            Read the case study
            <ArrowRight class="size-4" aria-hidden="true" />
          </Button>
          {
            data.liveUrl && (
              <Button href={data.liveUrl} external variant="secondary">
                Open {data.title}
                <ArrowUpRight class="size-4 text-muted" aria-hidden="true" />
              </Button>
            )
          }
        </div>
      </div>
    </div>
  </Reveal>
</Section>
