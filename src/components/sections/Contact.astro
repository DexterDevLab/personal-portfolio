---
import { Download, Mail } from "@lucide/astro";
import GithubIcon from "@/components/ui/GithubIcon.astro";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Reveal from "@/components/Reveal.astro";
import ContactForm from "@/components/ContactForm.astro";
import { site } from "@/data/site";
import { contactHelp } from "@/data/about";
---

<Section id="contact" class="border-t border-border">
  <SectionHeading
    eyebrow="Contact"
    title="Tell me about your project."
    description={`A new site, a web app, or something broken on WordPress: send a message and I'll get back to you ${site.responseTime}.`}
  />
  <div class="grid gap-10 md:grid-cols-[1fr_300px] lg:gap-14">
    <Reveal>
      <ContactForm />
    </Reveal>
    <Reveal delay={0.08}>
      <div class="flex flex-col gap-6">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Helpful to include</p>
          <ul class="mt-3 space-y-1.5 text-sm text-muted">
            {contactHelp.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="flex flex-col gap-3">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Direct</p>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center gap-2 py-1 text-sm text-foreground underline-offset-4 hover:underline"
          >
            <Mail class="size-4 text-muted" aria-hidden="true" />
            {site.email}
          </a>
          <a
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 py-1 text-sm text-muted transition-colors hover:text-foreground"
          >
            <GithubIcon />
            github.com/DexterDevLab
          </a>
          <a
            href={site.resume}
            class="mt-2 inline-flex min-h-11 w-fit items-center gap-2 rounded-button border border-border px-4 py-2.5 text-sm font-medium transition-colors hover:border-border-strong hover:bg-surface"
          >
            <Download class="size-4" aria-hidden="true" />
            Download résumé
          </a>
        </div>
      </div>
    </Reveal>
  </div>
</Section>
