---
import { Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Screenshot from "@/components/ui/Screenshot.astro";
import ModeSwitch from "@/components/lab/ModeSwitch.astro";
import { site } from "@/data/site";
import { intro } from "@/data/about";

/**
 * Static hero, shown when the 3D room is off (no WebGL, failure, or the
 * visitor's choice). Same content as the lab intro.
 */
interface Props {
  featured: CollectionEntry<"work">;
}
const { featured } = Astro.props;
const liveHost = featured.data.liveUrl ? new URL(featured.data.liveUrl).host : undefined;
---

<div id="top" class="relative overflow-hidden bg-background-deep grid-floor">
  <Container class="grid items-center gap-10 pt-28 pb-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-14 lg:pt-36 lg:pb-20">
    <div>
      <div class="animate-rise">
        <Eyebrow class="mb-5" tone="orange">{site.name} — {site.role}</Eyebrow>
      </div>
      <div class="animate-rise" style="--rise-delay: 0.08s">
        <h1 class="display max-w-xl text-4xl sm:text-5xl lg:text-[3.6rem]">
          {intro.headline}
        </h1>
      </div>
      <div class="animate-rise" style="--rise-delay: 0.16s">
        <p class="mt-6 max-w-xl text-base leading-relaxed text-muted md:text-lg">{intro.paragraph}</p>
      </div>
      <div class="animate-rise" style="--rise-delay: 0.24s">
        <div class="mt-8 flex flex-wrap items-center gap-3 sm:gap-4">
          <Button href="/#contact">
            Discuss your project
            <ArrowRight class="size-4" aria-hidden="true" />
          </Button>
          <Button href="/#work" variant="secondary">Explore my work</Button>
          <ModeSwitch />
        </div>
        {
          site.availability.show && (
            <p class="mt-5 flex items-center gap-2 text-sm text-muted">
              <span class="led bg-success" aria-hidden="true" />
              {site.availability.label}
            </p>
          )
        }
      </div>
    </div>

    <div class="animate-rise" style="--rise-delay: 0.2s">
      <a href={`/work/${featured.id}`} class="group block rounded-card" aria-label={`${featured.data.title} case study`}>
        <Screenshot label={liveHost} tag="Main system">
          <Image
            src={featured.data.screenshot}
            alt={featured.data.screenshotAlt}
            widths={[480, 720, 960, 1280]}
            sizes="(max-width: 1023px) calc(100vw - 2.5rem), 620px"
            priority
            class="aspect-[16/11] w-full object-cover object-top"
          />
        </Screenshot>
        <span class="mt-3 flex items-center justify-between gap-3 px-1 text-sm text-muted">
          <span>
            <span class="font-semibold text-foreground">{featured.data.title}</span>
            {featured.data.tagline && <span> — {featured.data.tagline}</span>}
          </span>
          <span class="inline-flex shrink-0 items-center gap-1 font-medium text-accent underline-offset-4 group-hover:underline">
            Case study
            <ArrowRight class="size-3.5" aria-hidden="true" />
          </span>
        </span>
      </a>
    </div>
  </Container>
</div>
