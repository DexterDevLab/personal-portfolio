---
import { Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Screenshot from "@/components/ui/Screenshot.astro";
import ModeSwitch from "@/components/lab/ModeSwitch.astro";
import { site } from "@/data/site";
import { intro } from "@/data/about";

interface Props {
  featured: CollectionEntry<"work">;
}
const { featured } = Astro.props;
const liveHost = featured.data.liveUrl ? new URL(featured.data.liveUrl).host : undefined;
---

<div id="top" class="relative overflow-hidden">
  <!-- Aurora glow — the one piece of ambient decoration on the page. -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="aurora-gradient absolute inset-0 md:hidden"></div>
    <div
      class="animate-aurora absolute top-[-20%] left-1/2 hidden h-125 w-200 -translate-x-1/2 rounded-full bg-accent-weak blur-[120px] md:block"
    >
    </div>
    <div
      class="animate-aurora-alt absolute top-[10%] left-1/2 hidden h-80 w-140 -translate-x-1/3 rounded-full bg-accent-weak blur-[100px] md:block"
    >
    </div>
  </div>

  <Container class="grid items-center gap-10 pt-28 pb-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-14 lg:pt-36 lg:pb-20">
    <!-- Pure-CSS entrance — hero text must not wait for JS (LCP). -->
    <div>
      <div class="animate-rise">
        <Eyebrow class="mb-5">{site.name} — {site.role}</Eyebrow>
      </div>
      <div class="animate-rise" style="--rise-delay: 0.08s">
        <h1 class="max-w-xl text-4xl leading-[1.08] font-semibold tracking-tight sm:text-5xl lg:text-[3.4rem]">
          {intro.headline}
        </h1>
      </div>
      <div class="animate-rise" style="--rise-delay: 0.16s">
        <p class="mt-6 max-w-xl text-base leading-relaxed text-muted md:text-lg">{intro.paragraph}</p>
      </div>
      <div class="animate-rise" style="--rise-delay: 0.24s">
        <div class="mt-8 flex flex-wrap items-center gap-3 sm:gap-4">
          <Button href="/#contact">
            Discuss your project
            <ArrowRight class="size-4" aria-hidden="true" />
          </Button>
          <Button href="/#work" variant="secondary">Explore my work</Button>
          <ModeSwitch class="min-h-11 px-5 py-2.5" />
        </div>
        {
          site.availability.show && (
            <p class="mt-5 flex items-center gap-2 text-sm text-muted">
              <span class="relative flex size-2" aria-hidden="true">
                <span class="absolute inline-flex size-full rounded-full bg-success opacity-60 motion-safe:animate-ping" />
                <span class="relative inline-flex size-2 rounded-full bg-success" />
              </span>
              {site.availability.label}
            </p>
          )
        }
      </div>
    </div>

    <!-- Real project preview: Panda Central's dashboard. LCP candidate, so it loads eagerly
         and is never wrapped in a reveal. -->
    <div class="hero-stage animate-rise" style="--rise-delay: 0.2s">
      <a
        href={`/work/${featured.id}`}
        class="hero-frame group block rounded-card focus-visible:outline-offset-4"
        aria-label={`${featured.data.title} case study`}
      >
        <Screenshot label={liveHost}>
          <Image
            src={featured.data.screenshot}
            alt={featured.data.screenshotAlt}
            widths={[480, 720, 960, 1280]}
            sizes="(max-width: 1023px) calc(100vw - 2.5rem), 620px"
            priority
            class="aspect-[16/11] w-full object-cover object-top"
          />
        </Screenshot>
        <span class="mt-3 flex items-center justify-between gap-3 px-1 text-sm text-muted">
          <span>
            <span class="font-medium text-foreground">{featured.data.title}</span>
            {featured.data.tagline && <span> — {featured.data.tagline}</span>}
          </span>
          <span class="inline-flex shrink-0 items-center gap-1 text-accent group-hover:underline underline-offset-4">
            Case study
            <ArrowRight class="size-3.5" aria-hidden="true" />
          </span>
        </span>
      </a>
    </div>
  </Container>
</div>
