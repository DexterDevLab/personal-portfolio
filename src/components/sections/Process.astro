---
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Reveal from "@/components/Reveal.astro";
import { processSteps } from "@/data/process";

/**
 * Four steps joined by a cable. On wide screens the cable runs behind the
 * steps and a signal travels along it as the section scrolls into view
 * (src/scroll/choreography.ts); without JS or motion the signal sits at
 * the first step. On narrow screens the cable is a vertical rail.
 */
const short = ["Understand", "Collaborate", "Build & test", "Launch & maintain"];
---

<Section id="process" compact tone="plain" class="border-y-2 border-border-strong">
  <SectionHeading eyebrow="How I work" title="Plain steps, no surprises." />
  <div class="relative">
    <svg
      data-process-cable
      class="pointer-events-none absolute inset-x-0 -top-0.5 hidden h-12 w-full lg:block"
      viewBox="0 0 1200 48"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        data-cable-path
        d="M24 24 C 200 24, 240 40, 400 24 S 600 8, 776 24 S 1000 40, 1176 24"
        fill="none"
        stroke="var(--line)"
        stroke-width="4"
        vector-effect="non-scaling-stroke"
      ></path>
      <circle data-cable-signal cx="24" cy="24" r="8" fill="var(--orange)" stroke="var(--line)" stroke-width="3" vector-effect="non-scaling-stroke"></circle>
    </svg>
    <ol class="relative grid gap-6 lg:grid-cols-4 lg:gap-8">
      {
        processSteps.map((step, i) => (
          <Reveal delay={i * 0.06}>
            <li class="relative flex gap-4 lg:block">
              <span
                class="outlined-sm z-10 flex size-11 shrink-0 items-center justify-center rounded-full bg-orange font-mono text-sm font-bold text-[#2b2b30] lg:mb-5"
                aria-hidden="true"
              >
                0{i + 1}
              </span>
              <div>
                <p class="label-mono text-muted">{short[i]}</p>
                <h3 class="mt-1 text-base font-bold">{step.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{step.description}</p>
              </div>
            </li>
          </Reveal>
        ))
      }
    </ol>
  </div>
</Section>
