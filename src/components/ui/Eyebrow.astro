---
/** Technical kicker label: a small teal status light + mono uppercase text. */
interface Props {
  class?: string;
  /** Colour of the status light. */
  tone?: "teal" | "orange" | "blue";
}
const { class: className, tone = "teal" } = Astro.props;
const dot = { teal: "bg-teal", orange: "bg-teal", blue: "bg-accent" }[tone];
---

<p class:list={["label-mono inline-flex items-center gap-2", className]}>
  <span class:list={["led", dot]} aria-hidden="true"></span>
  <slot />
</p>
