---
import Container from "./Container.astro";

interface Props {
  id?: string;
  class?: string;
  compact?: boolean;
  /** Full-bleed background treatment. */
  tone?: "plain" | "deep" | "floor" | "ink";
}
const { id, class: className, compact = false, tone = "plain" } = Astro.props;
const tones = {
  plain: "",
  deep: "bg-background-deep",
  floor: "bg-background-deep grid-floor",
  ink: "bg-[#2b2b30] text-[#f3eee4]",
};
---

<section
  id={id}
  class:list={["relative", compact ? "py-14 md:py-20" : "py-16 md:py-24", tones[tone], className]}
>
  <Container class="relative z-10">
    <slot />
  </Container>
</section>
