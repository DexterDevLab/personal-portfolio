---
/**
 * Small stack label: a quiet rounded chip with a teal marker, in the
 * mono voice of the kickers. `class="tag-ink"` tunes it for the dark
 * (ink) sections, which stay dark in both themes.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<span class:list={["tag", className]}>
  <slot />
</span>
