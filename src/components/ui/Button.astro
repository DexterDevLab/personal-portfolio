---
/**
 * Physical lab button: outlined, with a hard offset shadow that presses
 * down on click (see .btn in global.css).
 */
type Variant = "primary" | "secondary" | "teal" | "ghost";

interface Props {
  variant?: Variant;
  href?: string;
  external?: boolean;
  type?: "button" | "submit";
  size?: "md" | "sm";
  class?: string;
  [key: string]: unknown;
}

const {
  variant = "primary",
  href,
  external = false,
  type = "button",
  size = "md",
  class: className,
  ...rest
} = Astro.props;

const variants: Record<Variant, string> = {
  primary: "btn-primary",
  secondary: "",
  teal: "btn-teal",
  ghost: "btn-ghost",
};

const classes = ["btn", variants[variant], size === "sm" && "btn-sm", className];
---

{
  href ? (
    <a
      href={href}
      class:list={classes}
      target={external ? "_blank" : undefined}
      rel={external ? "noopener noreferrer" : undefined}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
