---
type Variant = "primary" | "secondary" | "ghost";

interface Props {
  variant?: Variant;
  href?: string;
  external?: boolean;
  type?: "button" | "submit";
  class?: string;
  [key: string]: unknown;
}

const {
  variant = "primary",
  href,
  external = false,
  type = "button",
  class: className,
  ...rest
} = Astro.props;

const variants: Record<Variant, string> = {
  primary: "bg-accent-strong text-white hover:opacity-90 border border-transparent",
  secondary:
    "border border-border bg-transparent text-foreground hover:border-border-strong hover:bg-surface",
  ghost: "text-muted hover:text-foreground",
};

const classes = [
  "inline-flex min-h-11 items-center justify-center gap-2 rounded-button px-5 py-2.5 text-sm font-medium transition-[background-color,border-color,color,opacity,transform] duration-200 active:scale-[0.98]",
  variants[variant],
  className,
];
---

{
  href ? (
    <a
      href={href}
      class:list={classes}
      target={external ? "_blank" : undefined}
      rel={external ? "noopener noreferrer" : undefined}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
