---
/**
 * Decorative layer behind the page sections. The props are a small cast of
 * original lab objects drawn in the room's language: 5-unit charcoal
 * outlines, flat teal/orange/cream fills, a hard offset shadow, chunky
 * proportions. src/scroll/choreography.ts moves them along the margins as
 * the visitor scrolls. The layer never takes pointer events and sits above
 * section backgrounds but below the content containers.
 */
import { PROPS } from "@/scroll/config";
const ink = "var(--line)";
---

<div class="props-layer" data-props-layer aria-hidden="true">
  {
    PROPS.map((p) => (
      <div class="prop" data-prop={p.id} style={`--prop-size:${p.size}px`}>
        <svg viewBox="0 0 100 100" fill="none" stroke={ink} stroke-width="5" stroke-linejoin="round" stroke-linecap="round">
          <filter id={`ps-${p.id}`} x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="3" dy="3" stdDeviation="0" flood-color="var(--shadow)" />
          </filter>
          <g filter={`url(#ps-${p.id})`}>
            {p.id === "wrench" && (
              <>
                <path d="M26 80 58 48" stroke-width="18" />
                <path d="M26 80 58 48" stroke="#b9c3cc" stroke-width="9" />
                <path d="M56 18a18 18 0 0 1 28 16l-12 12-18-18 2-10Z" fill="#b9c3cc" />
                <path d="M18 90a9 9 0 0 0 14-2" fill="#f58a35" />
              </>
            )}
            {p.id === "screwdriver" && (
              <>
                <path d="M18 82 52 48" stroke-width="12" />
                <path d="M18 82 52 48" stroke="#b9c3cc" stroke-width="5" />
                <rect x="46" y="20" width="22" height="46" rx="9" transform="rotate(45 57 43)" fill="#f58a35" />
                <rect x="52" y="24" width="10" height="16" rx="4" transform="rotate(45 57 32)" fill="#25252b" />
              </>
            )}
            {p.id === "gear" && (
              <>
                <path
                  d="M50 8l7 9 11-3 3 11 11 3-3 11 9 7-9 7 3 11-11 3-3 11-11-3-7 9-7-9-11 3-3-11-11-3 3-11-9-7 9-7-3-11 11-3 3-11 11 3z"
                  fill="#258f83"
                />
                <circle cx="50" cy="50" r="15" fill="#fffcf3" />
                <circle cx="50" cy="50" r="6" fill="#f58a35" />
              </>
            )}
            {p.id === "board" && (
              <>
                <rect x="10" y="18" width="80" height="64" rx="10" fill="#258f83" />
                <rect x="22" y="30" width="26" height="20" rx="4" fill="#25252b" />
                <path d="M58 34h18M58 44h18M58 54h10M22 62h44" stroke="#fffcf3" stroke-width="5" />
                <circle cx="78" cy="66" r="5" fill="#f58a35" />
                <path d="M28 18v-8M46 18v-8M64 18v-8M28 90v-8M46 90v-8M64 90v-8" />
              </>
            )}
            {p.id === "sheet" && (
              <>
                <path d="M22 8h40l18 18v66H22z" fill="#fffcf3" />
                <path d="M62 8v18h18" fill="#f5eedc" />
                <path d="M34 44h32M34 56h32M34 68h20" stroke="#258f83" />
                <path d="M34 30h16" stroke="#f58a35" stroke-width="8" />
              </>
            )}
            {p.id === "plug" && (
              <>
                <path d="M8 74c16 0 20-14 34-14h8" stroke="#258f83" stroke-width="7" />
                <rect x="46" y="40" width="34" height="34" rx="8" fill="#25252b" />
                <path d="M80 48h12M80 66h12" stroke="#b9c3cc" stroke-width="8" />
                <circle cx="58" cy="57" r="4" fill="#258f83" stroke="none" />
              </>
            )}
            {p.id === "bot" && (
              <>
                {/* The lab assistant's head: boxy skull, visor, two eyes, ear discs, antenna */}
                <path d="M50 20v-10" />
                <circle cx="50" cy="8" r="5" fill="#f58a35" />
                <rect x="18" y="22" width="64" height="54" rx="14" fill="#fffcf3" />
                <rect x="28" y="36" width="44" height="18" rx="6" fill="#25252b" />
                <rect x="36" y="42" width="9" height="6" rx="2" fill="#6b8dff" stroke="none" />
                <rect x="55" y="42" width="9" height="6" rx="2" fill="#6b8dff" stroke="none" />
                <circle cx="16" cy="50" r="7" fill="#258f83" />
                <circle cx="84" cy="50" r="7" fill="#258f83" />
                <path d="M38 76v10h24v-10" fill="#b9c3cc" />
              </>
            )}
          </g>
        </svg>
      </div>
    ))
  }
</div>
