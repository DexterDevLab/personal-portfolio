---
/**
 * Original line-art illustrations for the four services, in the room's
 * language: charcoal outlines, teal and orange fills, cream surfaces.
 *
 * Each drawing is its service's *finished* state (a page assembled, a site
 * repaired, modules connected, a server online). src/scroll/sections/
 * services.ts plays a short action into that state when the card comes into
 * view, using the `data-part` groups; without JS or motion the finished
 * state is simply shown.
 */
interface Props {
  kind: "layout" | "wrench" | "app" | "server";
  class?: string;
}
const { kind, class: className } = Astro.props;
const stroke = "var(--line)";
---

<svg
  viewBox="0 0 160 120"
  class:list={["h-auto w-full", className]}
  aria-hidden="true"
  fill="none"
  stroke={stroke}
  stroke-width="3"
  stroke-linejoin="round"
  stroke-linecap="round"
>
  {
    kind === "layout" && (
      <>
        {/* build station: a page assembled on the monitor, piece by piece */}
        <rect x="18" y="86" width="124" height="10" rx="3" fill="#c8a97a" />
        <path d="M28 96v16M132 96v16" />
        <rect x="46" y="22" width="68" height="46" rx="6" fill="#25252b" />
        <rect x="52" y="28" width="56" height="34" rx="3" fill="#fbf8f1" stroke="none" />
        <rect data-part="hdr" x="56" y="33" width="22" height="5" rx="2" fill="#258f83" stroke="none" />
        <rect data-part="btn" x="82" y="33" width="22" height="5" rx="2" fill="#258f83" stroke="none" />
        <rect data-part="line1" x="56" y="42" width="48" height="3" rx="1.5" fill="#cfc7b8" stroke="none" />
        <rect data-part="line2" x="56" y="49" width="40" height="3" rx="1.5" fill="#cfc7b8" stroke="none" />
        <rect data-part="img" x="56" y="55" width="48" height="5" rx="1.5" fill="#258f83" stroke="none" opacity="0.55" />
        <path d="M80 68v10M66 78h28" />
        <rect data-part="crate" x="118" y="70" width="18" height="16" rx="3" fill="#258f83" />
        <rect data-part="crate" x="22" y="74" width="16" height="12" rx="2" fill="#258f83" />
      </>
    )
  }
  {
    kind === "wrench" && (
      <>
        {/* repair bench: a small site device, fixed — antenna straight, status light teal, check badge */}
        <rect x="18" y="86" width="124" height="10" rx="3" fill="#c8a97a" />
        <path d="M28 96v16M132 96v16" />
        <g data-part="antenna">
          <path d="M60 52V26" stroke-width="4" />
          <circle cx="60" cy="22" r="5" fill="#258f83" />
        </g>
        <rect x="40" y="52" width="60" height="34" rx="8" fill="#fbf8f1" />
        <rect x="48" y="62" width="30" height="14" rx="2" fill="#25252b" />
        <circle data-part="lamp" cx="90" cy="69" r="5" fill="#258f83" />
        <g data-part="fault" opacity="0">
          <circle cx="112" cy="40" r="12" fill="#db5149" />
          <path d="M112 33v8M112 46v1" stroke="#fffcf3" stroke-width="3.5" />
        </g>
        <g data-part="ok">
          <circle cx="112" cy="40" r="12" fill="#258f83" />
          <path d="M106 40l4 4 8-9" stroke="#fffcf3" stroke-width="3.5" />
        </g>
        <g data-part="wrench">
          <path d="M104 86l26-26" stroke-width="10" stroke="#25252b" />
          <path d="M104 86l26-26" stroke-width="5" stroke="#9aa3ad" />
          <path d="M130 46a10 10 0 0 1 14 14l-6 6-14-14 6-6Z" fill="#9aa3ad" />
        </g>
      </>
    )
  }
  {
    kind === "app" && (
      <>
        {/* custom web app: modules wired into one working system */}
        <g data-part="link">
          <path class="cable-outline" d="M44 48h18" style="stroke-width:7" />
          <path class="cable-core" data-link-core d="M44 48h18" style="stroke-width:3" />
        </g>
        <g data-part="link">
          <path class="cable-outline" d="M98 48h18" style="stroke-width:7" />
          <path class="cable-core" data-link-core d="M98 48h18" style="stroke-width:3" />
        </g>
        <g data-part="link">
          <path class="cable-outline" d="M80 66v10" style="stroke-width:7" />
          <path class="cable-core" data-link-core d="M80 66v10" style="stroke-width:3" />
        </g>
        <g data-part="module-left">
          <rect x="14" y="30" width="30" height="36" rx="6" fill="#fbf8f1" />
          <circle cx="29" cy="48" r="5" fill="#258f83" />
        </g>
        <g data-part="module-right">
          <rect x="116" y="30" width="30" height="36" rx="6" fill="#fbf8f1" />
          <circle cx="131" cy="48" r="5" fill="#258f83" />
        </g>
        <rect x="62" y="30" width="36" height="36" rx="8" fill="#3b63e6" />
        <rect x="70" y="40" width="20" height="4" rx="2" fill="#fbf8f1" stroke="none" />
        <rect x="70" y="48" width="14" height="4" rx="2" fill="#fbf8f1" stroke="none" />
        <g data-part="module-bottom">
          <rect x="60" y="76" width="40" height="26" rx="6" fill="#258f83" />
          <circle data-part="hub" cx="80" cy="89" r="5" fill="#258f83" />
        </g>
      </>
    )
  }
  {
    kind === "server" && (
      <>
        {/* hosting: a server cabinet online, cable connected, lights on */}
        <rect x="46" y="12" width="68" height="96" rx="8" fill="#25252b" />
        {[0, 1, 2, 3].map((i) => (
          <>
            <rect x="54" y={20 + i * 22} width="52" height="16" rx="3" fill="#9aa3ad" />
            <rect x="58" y={30 + i * 22} width="22" height="3" rx="1.5" fill="#25252b" stroke="none" />
            <circle data-part="led" cx="98" cy={28 + i * 22} r="3.5" fill={i === 1 ? "#258f83" : "#258f83"} />
          </>
        ))}
        <path d="M24 108h112" />
        <g data-part="cable">
          <path class="cable-outline" d="M114 40c12 0 18 8 18 20s-6 20-18 20" style="stroke-width:7" />
          <path class="cable-core" data-cable-core d="M114 40c12 0 18 8 18 20s-6 20-18 20" style="stroke-width:3" />
        </g>
      </>
    )
  }
</svg>
