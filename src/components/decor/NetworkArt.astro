---
/**
 * What Panda Central does, as a diagram: several managed websites wired to
 * one dashboard. src/scroll/sections/featured.ts sends a signal from each
 * site into the centre when the section comes into view. The markup is the
 * completed state (every connection lit), so it reads without JS or motion.
 * Conceptual only: no counts, no live status.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// Site cards (x, y of the card's top-left) and the cable from each to the hub.
const sites = [
  { x: 8, y: 14, path: "M52 32 C 90 32, 100 66, 120 70" },
  { x: 8, y: 102, path: "M52 120 C 90 120, 100 86, 120 82" },
  { x: 228, y: 14, path: "M228 32 C 190 32, 180 66, 160 70" },
  { x: 228, y: 102, path: "M228 120 C 190 120, 180 86, 160 82" },
];
---

<svg
  viewBox="0 0 280 152"
  class:list={["h-auto w-full", className]}
  aria-hidden="true"
  fill="none"
  stroke="var(--line)"
  stroke-width="3"
  stroke-linejoin="round"
  stroke-linecap="round"
  data-network
>
  {/* cables first, so the cards sit on top */}
  {
    sites.map((s, i) => (
      <>
        <path class="cable-outline" d={s.path} style="stroke-width:7" />
        <path class="cable-core" d={s.path} data-net-cable={i} style="stroke-width:3" />
      </>
    ))
  }
  {/* site cards: a tiny browser window each */}
  {
    sites.map((s) => (
      <g>
        <rect x={s.x} y={s.y} width="44" height="36" rx="5" fill="#fffcf3" />
        <path d={`M${s.x} ${s.y + 9}h44`} />
        <circle cx={s.x + 6} cy={s.y + 4.5} r="1.5" fill="#f58a35" stroke="none" />
        <circle cx={s.x + 11} cy={s.y + 4.5} r="1.5" fill="#258f83" stroke="none" />
        <rect x={s.x + 6} y={s.y + 15} width="20" height="4" rx="2" fill="#258f83" stroke="none" />
        <rect x={s.x + 6} y={s.y + 23} width="30" height="3" rx="1.5" fill="#cfc7b8" stroke="none" />
      </g>
    ))
  }
  {/* the dashboard in the middle */}
  <rect x="120" y="50" width="40" height="52" rx="6" fill="#25252b" />
  <rect x="126" y="58" width="28" height="18" rx="2" fill="#fbf8f1" stroke="none" />
  <rect x="129" y="62" width="10" height="3" rx="1.5" fill="#258f83" stroke="none" />
  <rect x="129" y="68" width="18" height="3" rx="1.5" fill="#cfc7b8" stroke="none" />
  <rect x="126" y="82" width="28" height="4" rx="2" fill="#3d3d45" stroke="none" />
  <rect x="126" y="90" width="28" height="4" rx="2" fill="#3d3d45" stroke="none" />
  <circle cx="140" cy="112" r="5" fill="#f58a35" data-net-hub />
  {/* the signals, one per site; they travel along the cables */}
  {sites.map((_, i) => <circle class="signal-dot" r="5" cx="140" cy="76" style="stroke-width:2.5" data-net-dot={i} />)}
  <text x="140" y="140" text-anchor="middle" font-family="var(--font-geist-mono)" font-size="9" letter-spacing="1.5" fill="var(--ink-soft)" stroke="none">
    SITES → ONE DASHBOARD
  </text>
</svg>
