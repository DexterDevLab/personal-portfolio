---
/**
 * The lab assistant, as a flat cartoon, for the page below the room: it
 * walks down the left margin as the visitor scrolls and says a line at each
 * section (src/scroll/sections/robot.ts). Drawn in the room's language —
 * cream body, charcoal outlines, teal ear discs and chest plate, orange
 * antenna — in the same proportions as the 3D model (boxy head, capsule
 * torso, stubby legs). Purely decorative: hidden from assistive tech, never
 * takes pointer events, only shown where the margin has room (≥ 1280px),
 * and standing still under reduced motion.
 */
const ink = "#25252b";
---

<div class="page-robot" data-page-robot aria-hidden="true">
  <div class="page-robot__bubble" data-robot-bubble>
    <span data-robot-bubble-text></span>
    <i class="page-robot__dot page-robot__dot--a"></i>
    <i class="page-robot__dot page-robot__dot--b"></i>
  </div>
  <svg viewBox="0 0 80 120" fill="none" stroke={ink} stroke-width="3" stroke-linejoin="round" stroke-linecap="round" data-robot-body>
    <ellipse class="page-robot__shadow" cx="40" cy="116" rx="22" ry="4" fill={ink} opacity="0.25" stroke="none" />
    {/* legs (pivot at the hip) */}
    <g data-robot-leg="l" class="page-robot__leg">
      <rect x="27" y="84" width="10" height="20" rx="4" fill="#b9c3cc" />
      <rect x="23" y="101" width="18" height="9" rx="4" fill={ink} />
    </g>
    <g data-robot-leg="r" class="page-robot__leg">
      <rect x="43" y="84" width="10" height="20" rx="4" fill="#b9c3cc" />
      <rect x="39" y="101" width="18" height="9" rx="4" fill={ink} />
    </g>
    {/* body: capsule torso with a teal chest plate */}
    <g data-robot-torso>
      <rect x="20" y="50" width="40" height="38" rx="14" fill="#fffcf3" />
      {/* The logo's symbol printed on the torso (from src/assets/logo.svg, ~30 units tall) */}
      <g class="page-robot__emblem" transform="translate(26.5 53.5) scale(0.088)" stroke-width="16">
        <path d="M112 291 L204 291 Q222 303 235 331 Q241 344 225 346 H72 Q54 344 65 329 Q80 304 112 291Z" fill="#258f83" />
        <path d="M161 107 L175 62" fill="none" stroke-width="28" />
        <path d="M161 107 L175 62" fill="none" stroke="#258f83" stroke-width="10" />
        <path d="M49 102 Q49 88 65 88 H121 Q279 88 284 196 Q287 298 173 307 H62 Q47 307 47 290Z" fill="#fffcf3" />
        <path d="M111 144 Q100 144 100 160 V249 Q100 263 115 263 H172 Q231 263 231 206 Q231 151 174 147Z" fill="#258f83" />
        <path d="M116 174 V165 H129" fill="none" stroke="#73c5b7" stroke-width="10" />
        <path class="page-robot__code" d="M145 184 L124 205 L145 225 M184 184 L205 205 L184 225" fill="none" stroke="#f5eedc" stroke-width="13" />
        <path class="page-robot__code-glow" d="M145 184 L124 205 L145 225 M184 184 L205 205 L184 225" fill="none" stroke="#ffffff" stroke-width="18" />
        <g fill="#f58a35" stroke-width="10">
          <rect x="23" y="160" width="47" height="22" rx="11" />
          <rect x="23" y="194" width="47" height="22" rx="11" />
          <rect x="23" y="228" width="47" height="22" rx="11" />
        </g>
        <circle class="page-robot__beacon" cx="182" cy="46" r="28" fill="#f58a35" />
        <circle cx="175" cy="38" r="7" fill="#fff" stroke="none" />
      </g>
      {/* arms (pivot at the shoulder) */}
      <g data-robot-arm="l" class="page-robot__arm">
        <rect x="11" y="54" width="9" height="24" rx="4.5" fill="#fffcf3" />
        <circle cx="15.5" cy="79" r="4" fill="#b9c3cc" />
      </g>
      <g data-robot-arm="r" class="page-robot__arm page-robot__arm--r">
        <rect x="60" y="54" width="9" height="24" rx="4.5" fill="#fffcf3" />
        <circle cx="64.5" cy="79" r="4" fill="#b9c3cc" />
      </g>
    </g>
    {/* head: boxy skull, charcoal visor, two eyes, ear discs, antenna */}
    <g data-robot-head>
      <path d="M40 16v-8" />
      <circle cx="40" cy="6" r="4" fill="#258f83" />
      <rect x="16" y="16" width="48" height="36" rx="10" fill="#fffcf3" />
      <rect x="23" y="26" width="34" height="14" rx="5" fill={ink} />
      <rect class="page-robot__eye" x="29" y="30" width="7" height="6" rx="2" fill="#6b8dff" stroke="none" />
      <rect class="page-robot__eye" x="44" y="30" width="7" height="6" rx="2" fill="#6b8dff" stroke="none" />
      <circle cx="14" cy="34" r="5" fill="#258f83" />
      <circle cx="66" cy="34" r="5" fill="#258f83" />
    </g>
  </svg>
</div>

<style>
  .page-robot {
    position: fixed;
    top: 0;
    /* Beside the content column (2.5rem gap), however wide the margin is;
       the margin must be at least 7.5rem (≈ 1360px viewport) to fit it. */
    left: max(0.75rem, calc(var(--col-left) - 4.5rem - 2.5rem));
    z-index: 40; /* under the header (50) and station panels (60) */
    width: 4.5rem;
    display: none;
    opacity: 0;
    pointer-events: none;
    will-change: transform, opacity;
    transition: opacity 0.3s ease;
  }
  .page-robot svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .page-robot__leg,
  .page-robot__arm {
    transform-box: fill-box;
    transform-origin: 50% 8%;
  }
  .page-robot__eye {
    transform-box: fill-box;
    transform-origin: center;
  }
  /* Chest emblem: the symbol's antenna ball blinks like a beacon and the <>
     on its screen glows in a slow heartbeat (same as the plaque in the room). */
  .page-robot__beacon {
    transform-box: fill-box;
    transform-origin: center;
    animation: robot-beacon 1s steps(1, end) infinite;
  }
  .page-robot__code-glow {
    opacity: 0;
    animation: robot-code-glow 3.9s ease-in-out infinite;
  }
  @keyframes robot-beacon {
    0%, 85% { fill: #f58a35; }
    85.1%, 100% { fill: #ffe9b8; }
  }
  @keyframes robot-code-glow {
    0%, 100% { opacity: 0; }
    50% { opacity: 0.85; }
  }
  @media (prefers-reduced-motion: reduce) {
    .page-robot__beacon,
    .page-robot__code-glow {
      animation: none;
    }
  }
  /* The head pivots at the neck, the torso at the hips */
  [data-robot-head] {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  [data-robot-torso] {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  /* Thought bubble, like the one in the room: a compact pill above the head,
     right-aligned to the robot so it grows leftward into the margin and
     never crosses the content column (it is capped at the margin width). */
  .page-robot__bubble {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    width: max-content;
    max-width: min(8rem, calc(var(--col-left) - 1.5rem));
    bottom: calc(100% + 0.6rem);
    padding: 0.45rem 0.6rem;
    border: 2px solid #25252b;
    border-radius: 14px;
    background: #fffcf3;
    color: #25252b;
    font-family: var(--font-geist-mono);
    font-size: 0.68rem;
    line-height: 1.3;
    text-align: center;
    box-shadow: 3px 3px 0 0 #25252b;
    opacity: 0;
    translate: -50% 4px;
    transition:
      opacity 0.25s ease,
      translate 0.25s ease;
  }
  .page-robot__bubble.is-on {
    opacity: 1;
    translate: -50% 0;
  }
  .page-robot__dot {
    position: absolute;
    border: 2px solid #25252b;
    border-radius: 999px;
    background: #fffcf3;
  }
  .page-robot__dot--a {
    left: calc(50% - 0.3rem);
    bottom: -0.7rem;
    width: 0.55rem;
    height: 0.55rem;
  }
  .page-robot__dot--b {
    left: calc(50% - 0.2rem);
    bottom: -1.2rem;
    width: 0.35rem;
    height: 0.35rem;
  }
  /* Only where the margin has room; the script shows it on the page body. */
  @media (min-width: 1360px) {
    .page-robot[data-active] {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .page-robot,
    .page-robot__bubble {
      transition: none;
    }
  }
</style>
