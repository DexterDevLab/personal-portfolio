---
/**
 * Section divider in the room's language: a skirting board like the one at
 * the base of the lab's walls — a charcoal band with a lighter top edge, a
 * hard shadow underneath and a screw head every so often. Purely decorative.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={["skirting", className]} aria-hidden="true"></div>

<style>
  .skirting {
    position: relative;
    z-index: 1;
    height: 20px;
    background: var(--skirt);
    border-top: 3px solid var(--skirt-edge);
    border-bottom: 2px solid var(--line);
    box-shadow: 0 4px 0 0 var(--shadow);
    /* screw heads: a cream dot with a charcoal slot, one every 220px */
    background-image:
      linear-gradient(to right, transparent 0, transparent 50%, var(--skirt-slot) 50%, var(--skirt-slot) 51%, transparent 51%),
      radial-gradient(circle at 50% 50%, var(--skirt-screw) 0 4px, transparent 5px);
    background-size:
      220px 9px,
      220px 12px;
    background-position:
      0 center,
      0 center;
    background-repeat: repeat-x;
    --skirt: #25252b;
    --skirt-edge: #4a4a55;
    --skirt-screw: #cfc7b8;
    --skirt-slot: #25252b;
  }
  :global(.dark) .skirting {
    --skirt: #30303a;
    --skirt-edge: #55556a;
    --skirt-screw: #b8b2a6;
    --skirt-slot: #30303a;
  }
</style>
