# Brevo API key for the contact form (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=

# Where contact form messages are delivered (defaults to the site email if unset).
# Must be a verified sender in your Brevo account.
CONTACT_EMAIL=info@dexteriglesia.com

# Cloudflare Turnstile keys for the contact form's spam check (https://dash.cloudflare.com/?to=/:account/turnstile).
# Leave both empty to run without the challenge (honeypot + validation only).
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
